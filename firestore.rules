rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Roles / config lookups ────────────────────────────────
    // e.g. config/modWhitelist  →  { emails: ["a@b.com", ...] }
    // Publicly readable so the app can resolve a user's role right
    // after sign-in. Writes locked — edit from the Firebase console.
    match /config/{docId} {
      allow read:  if true;
      allow write: if false;
    }

    // ── Shared tasks / announcements ──────────────────────────
    match /tasks/{taskId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['name', 'end'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0;
      allow update, delete: if true;
    }

    // ── Per-user private task lists ───────────────────────────
    match /userTasks/{uid}/tasks/{taskId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Per-user completion state ─────────────────────────────
    match /userDone/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
