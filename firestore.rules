rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Roles / config lookups ────────────────────────────────
    // e.g. config/modWhitelist  →  { emails: ["a@b.com", ...] }
    // Publicly readable so the app can resolve a user's role right
    // after sign-in. Writes locked — edit from the Firebase console.
    match /config/{docId} {
      allow read:  if true;
      allow write: if false;
    }

    // ── Shared tasks / announcements ──────────────────────────
    match /tasks/{taskId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['name', 'end'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0;
      allow update, delete: if true;
    }

    // ── Per-user private task lists ───────────────────────────
    match /userTasks/{uid}/tasks/{taskId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Per-user completion state ─────────────────────────────
    match /userDone/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Short links (Tools → Link shortener) ──────────────────
    // Doc id = the short code. Publicly readable because the /r/<code>
    // Netlify Function resolves links for signed-out visitors.
    match /links/{code} {
      allow read: if true;

      // Only signed-in students, only under their own uid, and the code
      // in the document must match the doc id the client wrote to.
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.shortCode == code
                    && request.resource.data.originalURL is string
                    && request.resource.data.originalURL.matches('https?://.*')
                    && request.resource.data.originalURL.size() <= 2000
                    && request.resource.data.clicks == 0;

      // The click counter is bumped by the unauthenticated redirect
      // Function, so this update is open — but it can ONLY set clicks,
      // and only to exactly one more than the stored value.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks'])
                    && request.resource.data.clicks == resource.data.clicks + 1;

      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
    }

    // ── To Do list + Focus Deck ───────────────────────────────
    // Doc id = the owner's uid, holding one `items` array. Strictly
    // private: unlike widgetFeed this is never read by anything that
    // can't sign in, and the free-form notes on each item are exactly
    // the sort of thing that shouldn't be world-readable.
    match /todo/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Home-screen widget feed ───────────────────────────────
    // Doc id = the owner's uid. A home-screen widget has nowhere to sign
    // in, so the calendar publishes the one thing the widget can't work
    // out on its own — which shared tasks this person has already ticked
    // off, plus their personal tasks — to a publicly readable doc.
    // Opt-in: nothing exists here until the student turns the widget on,
    // and turning it off deletes the doc. Notes are never published.
    match /widgetFeed/{uid} {
      allow read:  if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Push notification tokens ──────────────────────────────
    // Doc id = the device's FCM token; written by the calendar when a
    // signed-in user turns notifications on. Only the Cloud Function
    // (admin SDK, bypasses rules) ever needs to read the list.
    match /fcmTokens/{token} {
      allow read: if false;
      allow create, update, delete: if request.auth != null;
    }
  }
}
